# Builds Sonarr directly from source (your fork). Uses the exact same
# backend build command the repo's own CI uses (confirmed working in
# GitHub Actions logs) -- a plain `dotnet publish <single csproj>` on this
# repo triggers StyleCop analyzer errors across the whole codebase that the
# solution-level build + PublishAllRids target does not hit.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src
COPY . .

# Node/Yarn for the frontend build (not present in the plain SDK image).
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g yarn && \
    rm -rf /var/lib/apt/lists/*

RUN yarn install --frozen-lockfile
RUN yarn build --env production

RUN dotnet msbuild -restore src/Sonarr.sln \
    -p:Configuration=Release -p:Platform=Posix -p:RuntimeIdentifiers=linux-x64 \
    -t:PublishAllRids

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /src/_output/net10.0/linux-x64/publish/ .
COPY --from=build /src/_output/UI ./UI

EXPOSE 8989
VOLUME ["/config"]

# NOTE: "Sonarr.dll" is a guess at the published output's entry assembly
# name -- if this fails on start, check what .dll actually landed in the
# copied publish folder above and fix this line to match.
ENTRYPOINT ["dotnet", "Sonarr.dll", "-nobrowser", "-data=/config"]
