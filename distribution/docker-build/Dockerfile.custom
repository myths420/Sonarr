# Builds Sonarr directly from source (your fork), bypassing build.sh -- v5
# dropped it. Uses the real commands from package.json and CONTRIBUTING.md
# instead: yarn build for frontend, dotnet publish on Sonarr.Console for
# backend, target framework net6.0 (per wiki.servarr.com/sonarr/contributing).
FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build

WORKDIR /src
COPY . .

# Node/Yarn for the frontend build (not present in the plain SDK image).
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g yarn && \
    rm -rf /var/lib/apt/lists/*

RUN yarn install --frozen-lockfile
RUN yarn build --env production

# NOTE: exact csproj path is my best-confidence guess based on Sonarr's
# established project layout (NzbDrone.Console historically houses the
# Sonarr.Console startup project). If this path is wrong the build will
# fail here with a clear "file not found" -- check src/ in your repo for
# the real path and fix this line.
RUN dotnet publish src/NzbDrone.Console/Sonarr.Console.csproj \
    -c Release -r linux-x64 --self-contained false -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:6.0
WORKDIR /app
COPY --from=build /app/publish .
COPY --from=build /src/_output/UI ./UI

EXPOSE 8989
VOLUME ["/config"]

# NOTE: "Sonarr.dll" is a guess at the published output's entry assembly
# name -- if this fails on start, check what .dll actually landed in
# /app/publish above and fix this line to match.
ENTRYPOINT ["dotnet", "Sonarr.dll", "-nobrowser", "-data=/config"]